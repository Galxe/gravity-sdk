# storage_v2_fresh_sync (TC9) test parameters
#
# Copy to test_params.toml (untracked), edit, then render:
#     cp test_params.toml.example test_params.toml
#     python render_config.py
#
# ── [source]: the OLD binary for the legacy core, i.e. v1.7.5 ────────────
# Same channel as storage_v2_upgrade: the v1.7.5 GitHub release asset
# (glibc >= 2.38) or the source-build fallback; see that case's README.
[source]
bin_path = "../target/quick-release/v1.7.5/gravity_node"

# ── [sf_source]: the NEW binary for the five SF nodes ────────────────────
# The same merge v2.3.0 binary the legacy core is upgraded TO (the case
# asserts both facts at phase 1). Until greth wires a fresh-init SF
# switch, this build must carry the #391 preflight fix — form D enables
# SF via `db migrate-changesets` on the freshly initialized datadir.
[sf_source]
bin_path = "../target/quick-release/gravity_node"

# ── [sf]: how fresh nodes get the SF layout ──────────────────────────────
# "migrate" (form D, default): first start -> stop -> db migrate-changesets
#           -> restart. Works with any binary carrying the #391 fix.
# "flag"    (form B, reserved): start SF nodes with --storage.v2 wired to
#           init_genesis. Accepted by the renderer so this file survives
#           the greth wiring, but the case refuses it until Node.start()
#           can inject per-node args.
[sf]
mode = "migrate"

[genesis_contracts]
repo = "https://github.com/Galxe/gravity_chain_core_contracts.git"
ref = "main"

# ── [hardforks]: same operational rule as storage_v2_upgrade ─────────────
# Alpha must NOT activate before the whole legacy core runs the new
# binary (v1.7.5 cannot execute post-Alpha semantics); the schedule is
# fixed at render time. Re-render shortly before each run.
#
# betaBlock = 100: activates on v1.7.5, schedule-only fork.
# gammaBlock = 4500: crossed at ~20 min of chain time (~3.8 blocks/s
#   measured) — after the fleet completes upgrading (~render+19 min on
#   the compressed schedule below).
[hardforks]
betaBlock = 100
gammaBlock = 4500

# alphaTime = render_time + upgrade_budget + stability_window + margin.
# Sized from MEASURED attempt5 timings, not TC2's 6-node legacy tier
# (+27m/+13m/+10m): the whole 4-node rolling upgrade took ~7 min live,
# and every extra minute of schedule is a minute of extra chain age the
# five SF nodes must replay from 0 at a net convergence of only
# ~1.4-1.9 blk/s (tc9-catchup-freeze-investigation.md) — halving the
# chain age roughly halves the from-0 catch-up cost.
#   upgrade_budget +12m: runner init/deploy ~4-5 min + phase 1 (~1 min)
#                        + phase 2 history/funding/epoch-cross
#                        (~4.5 min) + the ~7 min upgrade train overlaps
#                        into the next two components;
#   stability_window +5m / margin +5m: upgrade tail + slack.
# Total 22 min from render ≈ 17 min at the phase-1 guard — clears the
# case's ALPHA_MIN_LEAD_S floor (14 min, sized to the ~12.5 min
# phase-1→fleet-complete critical path) with ~4 min of slack. Do NOT
# stretch this back to the TC2 tier: it directly inflates phases 4-8.
[hardforks.alphaTime]
upgrade_budget = "+12m"
stability_window = "+5m"
margin = "+5m"
